{
  "name": "cross-hunt",
  "version": "1.0.0",
  "description": "A high-end, cinematic Cruise Ship Tour + Travel Ticket + Private Maritime Event Booking Platform",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,cyan\" \"node run-backend.js\" \"npm run dev --prefix frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "node run-backend.js",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install && npm install --prefix frontend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pareshprajapati-777/Cross-Hunt.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
