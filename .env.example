# =====================================================================
# Cruise-Hunt FastAPI Backend Environment Configuration (Template)
# =====================================================================

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True

# Database (Default: local SQLite database)
DATABASE_URL=sqlite:///db.sqlite3

# CORS Allowed Origins (JSON array or comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:8000","http://localhost:8000"]

# Optional Public/Network URL for Phone QR Code Verification
# PUBLIC_APP_URL=https://your-domain-or-tunnel.com

# AI Configuration (Dolphin AI 🐬 Concierge)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Business Cloud API Configuration
WHATSAPP_API_ENABLED=True
WHATSAPP_API_PROVIDER=META_CLOUD_SIMULATOR
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_REMINDER_HOURS_BEFORE=24

# Razorpay & Online UPI Payment Gateway
RAZORPAY_KEY_ID=rzp_test_CruiseHuntMaritime
RAZORPAY_KEY_SECRET=
RAZORPAY_MERCHANT_NAME=Cruise Hunt Maritime
RAZORPAY_UPI_ID=cruisehunt@razorpay
